# Kanonik site adresi. Metadata (metadataBase, canonical), sitemap.xml,
# robots.txt ve JSON-LD bunun üzerinden üretilir — yanlışsa tüm canonical
# ve sitemap URL'leri yanlış domaine işaret eder.
#
# Lokalde boş bırakılabilir: src/lib/site.ts tanımlı değilse
# https://bubaskalezzet.com değerine düşer.
# Vercel'de: Project → Settings → Environment Variables altında,
# gerçek production domaini ile (sonda / olmadan) tanımlayın.
NEXT_PUBLIC_SITE_URL=https://bubaskalezzet.com
